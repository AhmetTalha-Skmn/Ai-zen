# systemd birimi: /etc/systemd/system/aizen-posta.service
# pwsh yolu kuruluma gore degisir: `command -v pwsh` ciktisini ExecStart'a yazin
# (apt ile /usr/bin/pwsh, snap ile /snap/bin/pwsh).
[Unit]
Description=Aizen posta kutusu sunucusu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aizen-posta
Group=aizen-posta
Environment=HOME=/var/lib/aizen-posta
Environment=POWERSHELL_TELEMETRY_OPTOUT=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/usr/bin/pwsh -NoProfile -NonInteractive -File /opt/aizen-posta/posta-sunucu.ps1 -VeriKlasoru /var/lib/aizen-posta -Dinle 127.0.0.1 -Port 8790
Restart=on-failure
RestartSec=5

# Sertlestirme: sunucu yalnizca veri klasorune yazar ve yalnizca 127.0.0.1'i dinler (HTTPS Caddy'de).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aizen-posta
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
